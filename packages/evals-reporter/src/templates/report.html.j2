<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Auth0 SDK Eval Report</title>
  <script>
    try {
      if (localStorage.getItem('auth0-evals-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
    } catch (_) {}
  </script>
  <style>{% include 'report.css' %}</style>
</head>
<body>

{# ── helpers ─────────────────────────────────────────────────────────────── #}

{% macro pct_cell(rate, delta, cost) %}
<td class="pct-cell {{ rate | rate_css_class }}" data-score="{{ (rate * 100) | round | int }}">
  <span class="pct-value">{{ (rate * 100) | round | int }}%</span>
  {% if delta is not none %}
    {% set dp = (delta * 100) | round | int %}
    {% if dp > 0 %}
      <span class="delta delta-pos">+{{ dp }}%</span>
    {% elif dp < 0 %}
      <span class="delta delta-neg">{{ dp }}%</span>
    {% else %}
      <span class="delta delta-zero">0%</span>
    {% endif %}
  {% endif %}
  {% if cost is defined and cost is not none %}
    <span class="cell-cost">${{ "%.4f" | format(cost) }}</span>
  {% endif %}
</td>
{% endmacro %}

{% macro empty_cell() %}
<td class="empty-cell">&mdash;</td>
{% endmacro %}

{# ── summary table for a single mode ────────────────────────────────────── #}
{# Rows = models, Columns = evals                                            #}

{% macro render_summary_table_for_mode(variant, variant_grouped, evals_run, models_run, deltas) %}
{% set mode_data = variant_grouped[variant] if variant_grouped[variant] else {} %}
{% set mode_deltas = deltas[variant] if deltas[variant] else {} %}
<div class="summary-wrap" tabindex="0" aria-label="Scrollable pass-rate comparison matrix">
  <table class="summary-table">
    <caption class="sr-only">Grader pass rates by model and evaluation for {{ variant }}</caption>
    <thead>
      <tr>
        <th class="summary-eval-heading" scope="col">Model</th>
        {% for eval_id in evals_run %}
        <th class="summary-column-heading" scope="col">
          <div class="summary-column-model">{{ eval_id }}</div>
        </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for model in models_run %}
      <tr class="summary-row">
        <th class="summary-eval-id" scope="row">{{ model }}</th>
        {% for eval_id in evals_run %}
          {% set result = mode_data[eval_id][model] if mode_data[eval_id] and mode_data[eval_id][model] else none %}
          {% if result and result.grader_pass_rate is not none %}
            {% set d = mode_deltas[eval_id][model] if mode_deltas[eval_id] and mode_deltas[eval_id][model] is not none else none %}
            {% set c = result.cost_usd if result.cost_usd else none %}
            {{ pct_cell(result.grader_pass_rate, d, c) }}
          {% else %}
            {{ empty_cell() }}
          {% endif %}
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# ── graders table ────────────────────────────────────────────────────────── #}

{% macro render_graders(graders) %}
<table class="graders-table">
  {% for g in graders %}
  <tr>
    <td class="grader-icon {{ 'grader-pass' if g.passed else 'grader-fail' }}">{{ "✓" if g.passed else "✗" }}</td>
    <td class="grader-name">
      <span class="grader-kind">{{ g.kind }}</span>
      {{ g.name }}
    </td>
    <td class="grader-detail">{% if g.kind == "judge" %}{{ "yes" if g.passed else "no" }}{% else %}{{ g.detail if g.detail else "" }}{% endif %}</td>
  </tr>
  {% endfor %}
</table>
{% endmacro %}

{# ── judge tab ─────────────────────────────────────────────────────────────── #}

{% macro render_judge(judge_graders) %}
{% if not judge_graders %}
<div class="tab-panel-empty">No judge graders recorded.</div>
{% else %}
<div class="judge-list">
  {% for g in judge_graders %}
  <div class="judge-entry">
    <div class="judge-verdict">
      <span class="judge-verdict-badge {{ 'judge-pass' if g.passed else 'judge-fail' }}">{{ "Pass" if g.passed else "Fail" }}</span>
      <span class="judge-question">{{ g.name }}</span>
      {% if g.cost_usd is defined and g.cost_usd is not none %}<span class="judge-cost">${{ "%.4f" | format(g.cost_usd) }}</span>{% endif %}
    </div>
    {{ g.detail | judge_html | safe }}
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{# ── score breakdown ──────────────────────────────────────────────────────── #}

{% macro render_dim_group(dims, title) %}
<tr>
  <td colspan="5" class="dimension-group-header">{{ title }}</td>
</tr>
{% for dim in dims %}
{% set weighted = dim.weighted if dim.weighted else (dim.score * dim.weight if dim.score and dim.weight else 0) %}
<tr>
  <td class="dimension-name">{{ dim.name if dim.name else "" }}</td>
  <td class="dimension-score">{{ "%.1f" | format(dim.score if dim.score else 0) }}</td>
  <td class="dimension-weight">&times; {{ "%.2f" | format(dim.weight if dim.weight else 0) }}</td>
  <td class="dimension-weighted">= {{ "%.2f" | format(weighted) }}</td>
  <td class="dimension-grade">
    {% set grade = dim.grade if dim.grade else "" %}
    <span class="grade-badge {{ grade | grade_css_class }}">{{ grade }}</span>
  </td>
</tr>
{% endfor %}
{% endmacro %}

{% macro render_score_breakdown(dimensions, overall_score, overall_grade) %}
{% set process_dims = dimensions | batch(5) | first %}
{% set output_dims = [] %}
{% if dimensions | length >= 8 %}
  {% set output_dims = [dimensions[5], dimensions[6], dimensions[7]] %}
{% endif %}
<div class="score-breakdown">
  <div class="score-breakdown-title">Score Computation</div>
  <table class="score-table">
    {{ render_dim_group(process_dims, "Process Dimensions (50%)") }}
    {% if output_dims | length > 0 %}{{ render_dim_group(output_dims, "Output Dimensions (50%)") }}{% endif %}
    <tr class="weighted-total-row">
      <td class="weighted-total-label">Weighted Total</td>
      <td colspan="3" class="weighted-total-score">{{ "%.1f" | format(overall_score) }} / 100</td>
      <td class="weighted-total-grade">
        <span class="grade-badge grade-badge--lg {{ overall_grade | grade_css_class }}">{{ overall_grade }}</span>
      </td>
    </tr>
  </table>
  <div class="score-formula">
    Process (50%): friction&times;15% + speed&times;10% + efficiency&times;10% + errors&times;5% + docs&times;10%<br>
    Output (50%): correctness&times;25% + hallucination&times;15% + security&times;10%
  </div>
</div>
{% endmacro %}

{# ── turn metrics ─────────────────────────────────────────────────────────── #}

{% macro render_turn_metrics(metrics) %}
{% if not metrics or metrics | length == 0 %}
<div class="tab-panel-empty">No LLM turns recorded.</div>
{% else %}
{% set total_in = 0 %}
{% set total_out = 0 %}
{% set total_lat = 0 %}
{% set total_cost = 0 %}
{% for m in metrics %}
  {% set total_in   = total_in   + (m.input_tokens  if m.input_tokens  else 0) %}
  {% set total_out  = total_out  + (m.output_tokens if m.output_tokens else 0) %}
  {% set total_lat  = total_lat  + (m.llm_latency   if m.llm_latency   else 0) %}
  {% set total_cost = total_cost + (m.cost_usd      if m.cost_usd      else 0) %}
{% endfor %}
<div class="metrics-body">
  <table class="metrics-table">
    <tr class="metrics-thead">
      <th class="metrics-th">Turn</th>
      <th class="metrics-th metrics-th--r">In tokens</th>
      <th class="metrics-th metrics-th--r">Out tokens</th>
      <th class="metrics-th metrics-th--r">LLM latency</th>
      <th class="metrics-th metrics-th--r">Cost</th>
      <th class="metrics-th metrics-th--c">Finish</th>
      <th class="metrics-th metrics-th--c">Tools</th>
    </tr>
    {% for m in metrics %}
    {% set fr  = m.finish_reason if m.finish_reason else "unknown" %}
    {% set lat = m.llm_latency if m.llm_latency else 0 %}
    {% set cost = m.cost_usd if m.cost_usd else 0 %}
    <tr class="metrics-row">
      <td class="metrics-td">{{ m.turn }}</td>
      <td class="metrics-td metrics-td--r">{{ m.input_tokens if m.input_tokens else 0 }}</td>
      <td class="metrics-td metrics-td--r">{{ m.output_tokens if m.output_tokens else 0 }}</td>
      <td class="metrics-td metrics-td--r {{ lat | latency_css_class }}">{{ "%.1f" | format(lat) }}s</td>
      <td class="metrics-td metrics-td--r">${{ "%.4f" | format(cost) }}</td>
      <td class="metrics-td metrics-td--c"><span class="finish-pill {{ fr | finish_css_class }}">{{ fr }}</span></td>
      <td class="metrics-td metrics-td--c metrics-td--bright">{{ m.tool_call_count if m.tool_call_count else 0 }}</td>
    </tr>
    {% endfor %}
    <tr class="metrics-total-row">
      <td class="metrics-total-label">Total</td>
      <td class="metrics-total-val">{{ total_in }}</td>
      <td class="metrics-total-val">{{ total_out }}</td>
      <td class="metrics-total-val">{{ "%.1f" | format(total_lat) }}s</td>
      <td class="metrics-total-val">${{ "%.4f" | format(total_cost) }}</td>
      <td colspan="2"></td>
    </tr>
  </table>
</div>
{% endif %}
{% endmacro %}

{# ── session trace ─────────────────────────────────────────────────────────── #}

{% macro render_session_trace(trace) %}
{% if not trace or trace | length == 0 %}
<div class="tab-panel-empty">Agent completed without using any tools.</div>
{% else %}
<div class="metrics-body">
  <table class="metrics-table">
    {% for step in trace %}
    {% set action     = step.actionType if step.actionType else "" %}
    {% set size_bytes = step.resultSizeBytes if step.resultSizeBytes else 0 %}
    <tr class="metrics-row">
      <td class="metrics-td trace-step">{{ step.step }}</td>
      <td class="trace-action"><span class="action-pill {{ action | action_css_class }}">{{ action }}</span></td>
      <td class="trace-narrative">
        <span class="trace-call">
          <code class="trace-tool">{{ step.tool if step.tool else "" }}</code>
          {%- for key, val in step.args -%}
            {%- if val | length <= 60 -%}
            <span class="trace-arg"><span class="trace-arg-key">{{ key }}</span>=<span class="trace-arg-val">{{ val }}</span></span>
            {%- endif -%}
          {%- endfor -%}
          <span class="trace-dur">{{ "%.1f" | format(step.duration if step.duration else 0) }}s</span>
          {%- if size_bytes >= 1024 %}<span class="step-badge {{ size_bytes | size_css_class }}">{{ "%.1f" | format(size_bytes / 1024) }} KB</span>{%- endif %}
          {%- if step.isRetry %}<span class="step-badge badge-retry">&#8635; retry</span>{%- endif %}
          {%- if step.recoveredFromError %}<span class="step-badge badge-recovered">&#10003; recovered</span>{%- endif %}
          {%- if step.errorCategory %}<span class="step-badge badge-error-cat">{{ step.errorCategory }}</span>{%- endif %}
        </span>
        {%- for key, val in step.args -%}
          {%- if val | length > 60 -%}
          <div class="trace-block-arg"><span class="trace-arg-key">{{ key }}</span><pre class="trace-arg-pre">{{ val }}</pre></div>
          {%- endif -%}
        {%- endfor -%}
      </td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}
{% endmacro %}

{# ── recommendations ─────────────────────────────────────────────────────── #}

{% macro render_recommendations(recs) %}
{% if recs and recs.recommendations and recs.recommendations | length > 0 %}
<div class="rec-panel">
  {% if recs.summary %}
  <div class="rec-summary">{{ recs.summary }}</div>
  {% endif %}
  <ul class="rec-list">
    {% for r in recs.recommendations %}
    <li class="rec-item rec-severity-{{ r.severity }}">
      <div class="rec-item-header">
        <span class="rec-badge rec-badge--{{ r.category }}">{{ r.category }}</span>
        <span class="rec-badge" style="background: var(--clr-dim-bg); color: var(--text-sec);">{{ r.severity }}</span>
      </div>
      <div class="rec-issue">{{ r.issue }}</div>
      <div class="rec-suggestion">💡 {{ r.suggestion }}</div>
      {% if r.context %}
      <div class="rec-context">{{ r.context }}</div>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</div>
{% else %}
<div class="tab-panel-empty">No recommendations generated for this run.</div>
{% endif %}
{% endmacro %}

{# ── expandable run diagnostics ───────────────────────────────────────────── #}

{% macro render_detail_card(eval_id, model, variant, result) %}
{% set graders_list  = result.graders if result.graders else [] %}
{% set passed        = result.graders_passed if result.graders_passed is defined else (graders_list | selectattr("passed") | list | length) %}
{% set total         = result.graders_total if result.graders_total is defined else (graders_list | length) %}
{% set rate          = result.grader_pass_rate if result.grader_pass_rate is defined else (passed / total if total else 0) %}
{% set tokens        = result.tokens if result.tokens else 0 %}
{% set cost          = result.cost_usd if result.cost_usd else 0 %}
{% set judge_cost    = result.judge_cost_usd if result.judge_cost_usd else 0 %}
{% set total_cost    = result.total_cost_usd if result.total_cost_usd is defined else (cost + judge_cost) %}
{% set wall          = result.wall_time if result.wall_time else 0 %}
{% set rate_cls      = rate | rate_css_class %}
{% set dimensions    = result.dimensions if result.dimensions else [] %}
{% set overall_score = result.overall_score if result.overall_score is defined else none %}
{% set overall_grade = result.overall_grade if result.overall_grade is defined else none %}
{% set judge_graders = graders_list | selectattr("kind", "equalto", "judge") | list %}
{% set failed        = result.status != "success" %}

<details class="run-card{{ ' run-card--error' if failed }}">
  <summary class="run-summary">
    <span class="status-dot {{ 'status-dot--error' if failed else rate_cls }}" aria-hidden="true"></span>
    <span class="sr-only">{{ result.status if failed else 'Successful run' }}:</span>
    <span class="run-identity">
      <strong class="run-eval">{{ eval_id }}</strong>
      <span class="run-model">{{ model }}</span>
    </span>
    <span class="mode-badge">{{ variant }}</span>
    {% if failed %}
    <span class="error-label">{{ result.status | upper }}</span>
    {% else %}
    <span class="run-score"><span class="{{ rate_cls }} card-score-value">{{ (rate * 100) | round | int }}%</span><small>{{ passed }}/{{ total }} graders</small></span>
    {% if overall_grade %}<span class="grade-badge {{ overall_grade | grade_css_class }}">{{ overall_grade }}</span>{% endif %}
    <span class="run-cost">${{ "%.4f" | format(total_cost) }}</span>
    {% endif %}
    <span class="summary-chevron" aria-hidden="true"></span>
  </summary>
  <div class="run-diagnostics">
    {% if failed %}
    <section class="diagnostic-section diagnostic-section--error">
      <h4>Error details</h4>
      <pre class="error-message">{{ result.error if result.error else "Agent reached the turn limit without completing the task." }}</pre>
    </section>
    {% else %}
      {% if dimensions | length > 0 and overall_score is not none %}
      <section class="diagnostic-section" aria-label="Score dimensions">
        {{ render_score_breakdown(dimensions, overall_score, overall_grade) }}
      </section>
      {% endif %}
      <section class="diagnostic-section">
        <h4>Graders <span>{{ passed }}/{{ total }} passed</span></h4>
        {{ render_graders(graders_list) }}
      </section>
      {% if judge_graders | length > 0 %}
      <section class="diagnostic-section">
        <h4>Judge</h4>
        {{ render_judge(judge_graders) }}
      </section>
      {% endif %}
      {% if result.turn_metrics and result.turn_metrics | length > 0 %}
      <section class="diagnostic-section">
        <h4>Turn metrics</h4>
        {{ render_turn_metrics(result.turn_metrics) }}
      </section>
      {% endif %}
      {% if result.session_trace and result.session_trace | length > 0 %}
      <section class="diagnostic-section">
        <h4>Session trace</h4>
        {{ render_session_trace(result.session_trace) }}
      </section>
      {% endif %}
      {% if result.recommendations is defined and result.recommendations %}
      <section class="diagnostic-section">
        <h4>Recommendations</h4>
        {{ render_recommendations(result.recommendations) }}
      </section>
      {% endif %}
      <div class="card-footer" aria-label="Run resource usage">
        <span>{{ "%.1f" | format(wall) }}s wall time</span>
        <span>{{ tokens }} tokens</span>
        <span>${{ "%.4f" | format(cost) }} run + ${{ "%.4f" | format(judge_cost) }} judge = ${{ "%.4f" | format(total_cost) }}</span>
      </div>
    {% endif %}
  </div>
</details>
{% endmacro %}

{# ── run group ────────────────────────────────────────────────────────────── #}

{% macro render_detail_section(eval_id, results_for_eval) %}
<section class="detail-section" data-eval="{{ eval_id }}">
  <h3 class="detail-section-title">{{ eval_id }}</h3>
  {% set sorted_keys = results_for_eval | sort_result_keys %}
  {% for key in sorted_keys %}
  {% set parts = key.split("|") %}
  {% set model   = parts[0] %}
  {% set variant = parts[1] %}
  {% set result = results_for_eval[key] %}
  <div class="detail-card-wrap" data-model="{{ model }}" data-variant="{{ variant }}">
    {{ render_detail_card(eval_id, model, variant, result) }}
  </div>
  {% endfor %}
</section>
{% endmacro %}

{# ══════════════════════════════════════════════════════════════════════════ #}
{# Page body                                                                  #}
{# ══════════════════════════════════════════════════════════════════════════ #}

<header class="app-header">
  <div class="header-brand">
    <span class="brand-mark" aria-hidden="true">A0</span>
    <div>
      <strong>Auth0 Evals</strong>
      <span>Analytics report</span>
    </div>
  </div>
  <div class="header-actions">
    <div class="variant-control">
      <label for="filter-variant">Variant</label>
      <select id="filter-variant" aria-describedby="variant-help">
        {% for variant in variants_present %}
        <option value="{{ variant }}">{{ variant }}</option>
        {% endfor %}
      </select>
      <span class="sr-only" id="variant-help">Updates the comparison matrix and run explorer</span>
    </div>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Use dark theme" aria-pressed="false">
      <span aria-hidden="true">◐</span><span class="theme-toggle-label">Dark</span>
    </button>
  </div>
</header>

<main class="dashboard-shell">
  <section class="report-intro" aria-labelledby="report-title">
    <div>
      <p class="eyebrow">Evaluation performance</p>
      <h1 id="report-title">SDK integration report</h1>
      <p>Compare variants, spot regressions, and inspect every run.</p>
    </div>
    <time class="page-date">Generated {{ generated_at }}</time>
  </section>

  <section class="kpi-grid" aria-label="Report summary">
    <article class="kpi-tile">
      <span>Runs</span><strong>{{ total_runs }}</strong><small>across {{ evals_run | length }} evals</small>
    </article>
    <article class="kpi-tile kpi-tile--accent">
      <span>Average pass rate</span><strong>{{ (average_pass_rate * 100) | round | int }}%</strong><small>across {{ scored_run_count }} scored {{ "run" if scored_run_count == 1 else "runs" }}</small>
    </article>
    <article class="kpi-tile">
      <span>Total cost</span><strong>${{ "%.4f" | format(grand_total_cost) }}</strong><small>${{ "%.4f" | format(total_judge_cost) }} judge cost</small>
    </article>
    <article class="kpi-tile">
      <span>Models</span><strong>{{ models_run | length }}</strong><small>{{ models_run | join(", ") }}</small>
    </article>
  </section>

  <section class="workspace-panel comparison-panel" aria-labelledby="comparison-title">
    <div class="section-header">
      <div><p class="eyebrow">Overview</p><h2 id="comparison-title">Pass-rate comparison</h2></div>
      <div class="matrix-legend" aria-label="Pass-rate heat map legend"><span class="legend-high"></span>High <span class="legend-mid"></span>Medium <span class="legend-low"></span>Low</div>
    </div>
    {% for variant in variants_present %}
    <div class="summary-panel{{ ' active' if loop.first }}" data-variant="{{ variant }}"{% if not loop.first %} hidden{% endif %}>
      {{ render_summary_table_for_mode(variant, variant_grouped, evals_run, models_run, deltas) }}
    </div>
    {% endfor %}
  </section>

  <section class="workspace-panel explorer-panel" aria-labelledby="explorer-title">
    <div class="section-header explorer-heading">
      <div><p class="eyebrow">Diagnostics</p><h2 id="explorer-title">Run explorer</h2></div>
      <strong id="result-count" class="result-count" aria-live="polite">0 runs</strong>
    </div>
    <div class="filter-bar" role="search" aria-label="Filter runs">
      <div class="search-group">
        <label class="sr-only" for="filter-search">Search runs</label>
        <span aria-hidden="true">⌕</span>
        <input id="filter-search" type="search" placeholder="Search evals, models, graders…" autocomplete="off">
      </div>
      <div class="filter-group">
        <label class="filter-label" for="filter-eval">Eval</label>
        <select class="filter-select" id="filter-eval">
          <option value="__all__">All evals</option>
          {% for eval_id in grouped_sorted_keys %}<option value="{{ eval_id }}">{{ eval_id }}</option>{% endfor %}
        </select>
      </div>
      <div class="filter-group">
        <label class="filter-label" for="filter-model">Model</label>
        <select class="filter-select" id="filter-model">
          <option value="__all__">All models</option>
          {% for model in models_run %}<option value="{{ model }}">{{ model }}</option>{% endfor %}
        </select>
      </div>
      <button class="clear-filters" id="clear-filters" type="button">Clear</button>
    </div>

    <div id="details-container">
      {% for eval_id in grouped_sorted_keys %}{{ render_detail_section(eval_id, grouped[eval_id]) }}{% endfor %}
    </div>
    <p class="empty-results" id="empty-results" hidden>No runs match these filters.</p>
  </section>
</main>

<footer class="page-footer">Generated by auth0-evals · Self-contained report</footer>

<script>
(function() {
  var variant = document.getElementById('filter-variant');
  var evalFilter = document.getElementById('filter-eval');
  var modelFilter = document.getElementById('filter-model');
  var searchFilter = document.getElementById('filter-search');
  var resultCount = document.getElementById('result-count');
  var emptyResults = document.getElementById('empty-results');
  var themeToggle = document.getElementById('theme-toggle');

  function applyFilters() {
    var query = searchFilter.value.trim().toLowerCase();
    var visible = 0;

    document.querySelectorAll('.detail-card-wrap').forEach(function(wrap) {
      var section = wrap.closest('.detail-section');
      var matches = wrap.dataset.variant === variant.value &&
        (evalFilter.value === '__all__' || section.dataset.eval === evalFilter.value) &&
        (modelFilter.value === '__all__' || wrap.dataset.model === modelFilter.value) &&
        (!query || wrap.textContent.toLowerCase().indexOf(query) !== -1);
      wrap.hidden = !matches;
      if (matches) visible += 1;
    });

    document.querySelectorAll('.detail-section').forEach(function(section) {
      section.hidden = !section.querySelector('.detail-card-wrap:not([hidden])');
    });
    resultCount.textContent = visible + (visible === 1 ? ' run' : ' runs');
    emptyResults.hidden = visible !== 0;
  }

  function selectVariant() {
    document.querySelectorAll('.summary-panel').forEach(function(panel) {
      var active = panel.dataset.variant === variant.value;
      panel.hidden = !active;
      panel.classList.toggle('active', active);
    });
    applyFilters();
  }

  function setTheme(dark) {
    if (dark) document.documentElement.dataset.theme = 'dark';
    else delete document.documentElement.dataset.theme;
    themeToggle.setAttribute('aria-pressed', String(dark));
    themeToggle.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
    themeToggle.querySelector('.theme-toggle-label').textContent = dark ? 'Light' : 'Dark';
    try { localStorage.setItem('auth0-evals-theme', dark ? 'dark' : 'light'); } catch (_) {}
  }

  variant.addEventListener('change', selectVariant);
  evalFilter.addEventListener('change', applyFilters);
  modelFilter.addEventListener('change', applyFilters);
  searchFilter.addEventListener('input', applyFilters);
  document.getElementById('clear-filters').addEventListener('click', function() {
    evalFilter.value = '__all__';
    modelFilter.value = '__all__';
    searchFilter.value = '';
    applyFilters();
    searchFilter.focus();
  });
  themeToggle.addEventListener('click', function() {
    setTheme(document.documentElement.dataset.theme !== 'dark');
  });

  setTheme(document.documentElement.dataset.theme === 'dark');
  selectVariant();
})();
</script>
</body>
</html>
